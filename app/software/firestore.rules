rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Pillar 2: Validation Blueprint for UserAsset
    function isValidUserAsset(data) {
      return data.keys().hasAll(['ownerId', 'title', 'assetType', 'summary', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'assetType', 'summary', 'createdAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.assetType is string
        && data.assetType in ['template', 'image', 'video', 'music', 'science', 'transcript', 'grounding']
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 2000
        && data.createdAt is timestamp;
    }

    match /user_assets/{assetId} {
      allow get: if isSignedIn()
        && isValidId(assetId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(assetId)
        && isValidUserAsset(incoming())
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && isValidId(assetId)
        && isValidUserAsset(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary']);

      allow delete: if isSignedIn()
        && isValidId(assetId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
