{
  "entities": {
    "UserAsset": {
      "title": "UserAsset",
      "description": "User saved templates, AI generated assets, or scientific macromolecular records.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the saved template or AI asset",
          "minLength": 1,
          "maxLength": 160
        },
        "assetType": {
          "type": "string",
          "description": "Type of saved record",
          "enum": ["template", "image", "video", "music", "science", "transcript", "grounding"]
        },
        "summary": {
          "type": "string",
          "description": "Prompt, description, or scientific summary",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["ownerId", "title", "assetType", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/user_assets/{assetId}": {
      "schema": { "$ref": "#/entities/UserAsset" },
      "description": "Private user workspace collection for saved templates, AI generations, and scientific query records."
    }
  }
}
