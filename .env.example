# Railway private PostgreSQL URL. Configure secrets in Railway or ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_SITE_URL=https://onefinsolution.net
# Optional; when unset in production, derived from NEXT_PUBLIC_SITE_URL hostname.
SESSION_COOKIE_DOMAIN=onefinsolution.net
SESSION_SECRET=replace-with-long-random-string
WORKSPACE_SIGNING_KEY=replace-with-long-random-string

# Billing
BILLING_PROVIDER=stripe
# test | live — production NODE_ENV alone never implies Live Mode
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_ACCOUNT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional overrides; catalog is normally resolved via Stripe lookup_keys (onefin_v2_*).
# STRIPE_PRICE_DAILY=
# STRIPE_PRICE_WEEKLY=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=

# Email (Resend preferred). Domain onefinsolution.net must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=One Fin Solution <noreply@onefinsolution.net>
EMAIL_FROM_AUTH=One Fin Solution Auth <auth@onefinsolution.net>
EMAIL_FROM_BILLING=One Fin Solution Billing <billing@onefinsolution.net>
EMAIL_REPLY_TO=support@onefinsolution.net
# Optional recipient for scripts/verify-resend-setup.mjs
EMAIL_TEST_TO=

# Optional SMTP fallback when RESEND_API_KEY is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional Railway CLI targeting for scripts/configure-railway.mjs
# RAILWAY_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT=production

# Optional: software storefront Stripe product/price map (from npm run stripe:provision-software)
# STRIPE_SOFTWARE_CATALOG=
